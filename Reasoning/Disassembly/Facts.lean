import EVM.Disassembly.Compute
import EVM.Disassembly.JumpTable
import Reasoning.Disassembly.Immutables
import Reasoning.Disassembly.Appended
import Reasoning.JumpDest
import Mathlib.Tactic.Eval

/-!
# Theorems of a bytecode file

A contract's bytecode file (`Bytecode.lean` or `CreationBytecode.lean`) is generated by
`scripts/gen_bytecode.py` and looks like this:

```
def Foo.fooBytecode : ByteArray := ⟨#[0x60, 0x80, …]⟩

namespace Foo.Bytecode
noncomputable def tree : EVM.Disassembly.Tree :=
  eval% EVM.Disassembly.Tree.ofSections (sectionsOf Foo.fooBytecode [])
def bytes : List UInt8 := Foo.fooBytecode.data.toList
noncomputable def sections : List (Nat × List Instr) := tree.flat []
theorem check : Checked bytes sections := by decide +kernel
…
end Foo.Bytecode
```

`tree` is computed by `eval%` when the file is elaborated, and `check` verifies it in the kernel.
The other theorems of the file (`decodes_code`, `jumpdest_code`, …) are instances of the lemmas
below, which restate the results of `EVM.Disassembly` in terms of `tree.get?`.
-/

open Ethereum Ethereum.EVM EVM.Disassembly

set_option autoImplicit false

namespace Reasoning.Disassembly

variable {bytes : List UInt8} {tree : Tree} {code : ByteArray} {σ : Nat → UInt256}

/-- Lookup in the tree is lookup in its sections. -/
theorem tree_get (h : Checked bytes (tree.flat [])) (t : Nat) :
    tree.get? t = (tree.flat []).lookup t :=
  Tree.get?_eq_lookup rfl h.ascending t

/-- Membership in `D_J` is a lookup in the tree. -/
theorem contains_eq_tree (h : Checked code.data.toList (tree.flat [])) (t : UInt256) :
    (D_J code 0).contains t = ((tree.get? t.toNat).map startsJD).getD false :=
  h.contains_eq (tree_get h) t

/-- A section found in the tree decodes at its offset in `code`. -/
theorem decodes_tree (h : Checked bytes (tree.flat []))
    (he : code = filled bytes σ (tree.flat [])) {t : Nat} {s : List Instr}
    (hs : tree.get? t = some s) : Decodes code σ (UInt256.ofNat t) s :=
  he ▸ (h.decodes_lookup σ (tree_get h t ▸ hs)).word

/-- The offset of a section that starts with a `JUMPDEST` is a valid jump destination of `code`. -/
theorem jumpdest_tree (h : Checked bytes (tree.flat []))
    (he : code = filled bytes σ (tree.flat [])) {t : Nat} {s : List Instr}
    (hs : tree.get? t = some s) (hjd : startsJD s = true) (ht : t < 2 ^ 256) :
    (D_J code 0).contains (UInt256.ofNat t) = true :=
  he ▸ (h.jumpdest_iff_nat σ ht).mpr ⟨s, mem_of_lookup (tree_get h t ▸ hs), hjd⟩

/-! ## Code followed by other data -/

/-- The side conditions for code followed by other data: the sections before `lim` end inside the
code, and the code size fits in 64 bits. -/
def tailCheck (table : List (Nat × List Instr)) (len lim : Nat) : Bool :=
  insideCheck table len lim && decide (len < 2 ^ 64)

/-- A section before `lim` decodes in `code ++ x`, for any `x`. -/
theorem decodes_appended_tree (h : Checked bytes (tree.flat []))
    (he : code = filled bytes σ (tree.flat [])) {lim : Nat}
    (hin : tailCheck (tree.flat []) bytes.length lim = true) (x : ByteArray) {t : Nat}
    {s : List Instr} (hs : tree.get? t = some s) (ht : t < lim) :
    Decodes (code ++ x) σ (UInt256.ofNat t) s := by
  simp only [tailCheck, Bool.and_eq_true, decide_eq_true_eq] at hin
  exact he ▸ (Checked.decodes_appended h σ x hin.1 hin.2 (tree_get h t ▸ hs) ht).word

/-- The offset of a section that starts with a `JUMPDEST` is a valid jump destination of `code ++
x`, for any `x`. -/
theorem jumpdest_appended_tree (h : Checked bytes (tree.flat []))
    (he : code = filled bytes σ (tree.flat [])) (x : ByteArray) {t : Nat} {s : List Instr}
    (hs : tree.get? t = some s) (hjd : startsJD s = true) (ht : t < 2 ^ 256) :
    (D_J (code ++ x) 0).contains (UInt256.ofNat t) = true :=
  he ▸ Checked.jumpdest_appended h σ x ht (mem_of_lookup (tree_get h t ▸ hs)) hjd

/-- The section at `lim` exists and its first `k` instructions end inside the code. -/
def lastCheck (tree : Tree) (len lim k : Nat) : Bool :=
  (tree.get? lim).isSome && decide (lim + sectionWidth (((tree.get? lim).getD []).take k) ≤ len)

/-- The first `k` instructions of the section at `lim` decode in `code ++ x`, for any `x`. -/
theorem decodes_last_tree (h : Checked bytes (tree.flat []))
    (he : code = filled bytes σ (tree.flat [])) {lim : Nat}
    (hin : tailCheck (tree.flat []) bytes.length lim = true) {k : Nat}
    (hk : lastCheck tree bytes.length lim k = true) (x : ByteArray) :
    Decodes (code ++ x) σ (UInt256.ofNat lim) (((tree.get? lim).getD []).take k) := by
  simp only [tailCheck, Bool.and_eq_true, decide_eq_true_eq] at hin
  simp only [lastCheck, Bool.and_eq_true, decide_eq_true_eq, Option.isSome_iff_exists] at hk
  obtain ⟨⟨s, hs⟩, hle⟩ := hk
  rw [hs, Option.getD_some] at hle ⊢
  exact he ▸ (Checked.decodes_appended_take h σ x hin.2 (tree_get h lim ▸ hs) k rfl hle).word

end Reasoning.Disassembly
