/-- `keccak("run(address,uint256)")[0:4] = 0x381fd190`. -/
axiom callerSelectorBytes :
    (ffi.KEC (String.toByteArray (Solm.transitionSigStr Caller.runTransition))).extract 0 4
      = ⟨#[0x38, 0x1f, 0xd1, 0x90]⟩

