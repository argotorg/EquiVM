/-- `keccak("pow2(uint256)")[0:4] = 0x442b7ffb`. -/
axiom powSelectorBytes :
    (ffi.KEC (String.toByteArray (Solm.transitionSigStr Pow.powTransition))).extract 0 4
      = ⟨#[0x44, 0x2b, 0x7f, 0xfb]⟩

