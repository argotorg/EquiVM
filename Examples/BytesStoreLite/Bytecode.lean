  | _ => none

private partial def hexCharsToArrayAux? : List Char -> Array UInt8 -> Option (Array UInt8)
  | [], acc => some acc
  | hi :: lo :: rest, acc => do
      let h <- hexNibble? hi
      let l <- hexNibble? lo
      hexCharsToArrayAux? rest (acc.push (h * 16 + l))
  | [_], _ => none

private def byteArrayOfHex? (s : String) : Option ByteArray := do
  let bytes <- hexCharsToArrayAux? s.toList #[]
  some ⟨bytes⟩

private def byteArrayOfHex! (s : String) : ByteArray :=
  match byteArrayOfHex? s with
  | some bytes => bytes
  | none => ByteArray.empty

