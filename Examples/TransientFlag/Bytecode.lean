    0xa1, 0x64, 0x73, 0x6f, 0x6c, 0x63, 0x43, 0x00, 0x08, 0x23, 0x00, 0x0a
  ]⟩

theorem setFlagSigStr :
    Solm.transitionSigStr TransientFlag.setFlagTransition = "setFlag(uint256)" := by
  native_decide

theorem getFlagSigStr :
    Solm.transitionSigStr TransientFlag.getFlagTransition = "getFlag()" := by
  native_decide

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `setFlag(uint256)` selector `0xd40c79f0`. -/
theorem setFlagSelectorBytes :
    (KEC (String.toByteArray (Solm.transitionSigStr TransientFlag.setFlagTransition))).extract 0 4
      = ⟨#[0xd4, 0x0c, 0x79, 0xf0]⟩ := by
  rw [setFlagSigStr]
  decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `getFlag()` selector `0xf9633930`. -/
theorem getFlagSelectorBytes :
    (KEC (String.toByteArray (Solm.transitionSigStr TransientFlag.getFlagTransition))).extract 0 4
      = ⟨#[0xf9, 0x63, 0x39, 0x30]⟩ := by
  rw [getFlagSigStr]
  decide +kernel

/-- `JUMPDEST` positions of `flagBytecode`. -/
@[valid_jumps] theorem flagValidJumps :
    Ethereum.EVM.D_J flagBytecode 0
      = #[⟨14⟩, ⟨48⟩, ⟨52⟩, ⟨63⟩, ⟨67⟩, ⟨69⟩, ⟨89⟩, ⟨97⟩, ⟨112⟩] := by
  native_decide
