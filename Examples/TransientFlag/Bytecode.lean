import Examples.TransientFlag.Spec
import Solm.Semantics
import Ethereum.Semantics
import Reasoning.JumpDest

open Solm Ethereum Ethereum.EVM

/-!
## Runtime bytecode

```
solc 0.8.35 --evm-version cancun --optimize --optimize-runs 0 --metadata-hash none --bin-runtime
```

The trailing bytes are solc's version-only CBOR suffix. Jumps never enter them.
-/

def flagBytecode : ByteArray :=
  ⟨#[
    0x60, 0x80, 0x60, 0x40, 0x52, 0x34, 0x80, 0x15, 0x60, 0x0e, 0x57, 0x5f,
