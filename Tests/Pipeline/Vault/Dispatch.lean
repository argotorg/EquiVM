theorem vaultDispatch_none_short {cd : ByteArray} (h : cd.size < 4) :
    dispatchMsg contract cd = none := by
  rw [dispatchMsg_eq_dispatchList contract cd, transitions_eq]
  refine dispatchList_none_short _ ?_ h
  intro t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [sweepSelectorOf]; rfl
  · rw [countSelectorOf]; rfl
  · rw [feeBpsSelectorOf]; rfl
  · rw [balancesSelectorOf]; rfl
  · rw [totalSelectorOf]; rfl
  · rw [withdrawSelectorOf]; rfl
  · rw [dropLastSelectorOf]; rfl
  · rw [ownerSelectorOf]; rfl
  · rw [depositSelectorOf]; rfl
  · rw [depositorsSelectorOf]; rfl
  · rw [tokenSelectorOf]; rfl

theorem vaultDispatch_none_nomatch {I : ExecutionEnv}
    (hnm : ∀ i, i < 11 → (vaultSelBytes i == I.calldata.extract 0 4) = false) :
    dispatchMsg contract I.calldata = none := by
  refine dispatchMsg_none_of_all_ne (contract := contract) (cd := I.calldata) (by rfl) (by rfl) ?_
  intro t ht
  rw [transitions_eq] at ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [sweepSelectorOf]; exact hnm 0 (by omega)
  · rw [countSelectorOf]; exact hnm 1 (by omega)
  · rw [feeBpsSelectorOf]; exact hnm 2 (by omega)
  · rw [balancesSelectorOf]; exact hnm 3 (by omega)
  · rw [totalSelectorOf]; exact hnm 4 (by omega)
  · rw [withdrawSelectorOf]; exact hnm 5 (by omega)
  · rw [dropLastSelectorOf]; exact hnm 6 (by omega)
  · rw [ownerSelectorOf]; exact hnm 7 (by omega)
  · rw [depositSelectorOf]; exact hnm 8 (by omega)
  · rw [depositorsSelectorOf]; exact hnm 9 (by omega)
  · rw [tokenSelectorOf]; exact hnm 10 (by omega)

/-! ## Runtime dispatcher paths -/

/-- Dispatcher path to `sweep(address)` (arm entry pc 170). -/
theorem vaultReachSweepBody {σ σ₀ A I} {g : Sat256} (v : VaultImmutables)
    (hcode : I.code = deployedRuntime v) (hwv : I.weiValue = ⟨0⟩) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (vaultSelBytes 0)) :
    ∃ k C, RD (deployedRuntime v) I g (initState σ σ₀ g A I) (UInt256.ofNat 170)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      ((UInt256.ofNat 128).toByteArray.write 0 ByteArray.empty (UInt256.ofNat 64).toNat 32)
      (M (UInt256.ofNat 0) (UInt256.ofNat 64) (⟨32⟩ : UInt256)) ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨23599714⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x01 0x68 0x1a 0x62 ⟨23599714⟩ (by native_decide)
      (by simpa [vaultSelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  have rd1 := vaultBlocks.vault_block_0_taken (immWords := wordsOf (immStore v)) (by simp) (by first | (rw [hwv]; decide) | exact isZero_eq_zero_of_ne hwv | exact hwv | simpa using hwv) (by rw [vaultPatchedValidJumpsRuntime v]; jump_dest) rd0
  have rd2 := vaultBlocks.vault_block_15_fallthrough (immWords := wordsOf (immStore v)) (by simp [vaultBlocks.vault_block_0_taken_stack, vaultBlocks.vault_block_0_taken_memory]) (by first | exact lt_four_eq_zero_of_ge hsz hsize | exact lt_four_ne_zero_of_lt hshort | exact isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort) | (rw [lt_four_eq_zero_of_ge hsz hsize]; decide) | (rw [isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort)]; decide)) rd1
  have rd3 := vaultBlocks.vault_block_25_taken (immWords := wordsOf (immStore v)) (by simp [vaultBlocks.vault_block_0_taken_stack, vaultBlocks.vault_block_0_taken_memory, vaultBlocks.vault_block_15_fallthrough_stack]) (by simpa [solcSelectorWord] using (show (UInt256.gt ⟨773487949⟩ (solcSelectorWord I)) ≠ ⟨0⟩ by rw [hword]; native_decide)) (by rw [vaultPatchedValidJumpsRuntime v]; jump_dest) rd2
  have rd4 := vaultBlocks.vault_block_110_taken (immWords := wordsOf (immStore v)) (by simp [vaultBlocks.vault_block_0_taken_stack, vaultBlocks.vault_block_0_taken_memory, vaultBlocks.vault_block_15_fallthrough_stack, vaultBlocks.vault_block_25_taken_stack]) (by simpa [solcSelectorWord] using (show (UInt256.eq ⟨23599714⟩ (solcSelectorWord I)) ≠ ⟨0⟩ by rw [hword]; native_decide)) (by rw [vaultPatchedValidJumpsRuntime v]; jump_dest) rd3
  exact ⟨_, _, by simpa [vaultBlocks.vault_block_0_taken_stack, vaultBlocks.vault_block_0_taken_memory, vaultBlocks.vault_block_15_fallthrough_stack, vaultBlocks.vault_block_25_taken_stack, deployedRuntime] using rd4⟩

/-- Dispatcher path to `count()` (arm entry pc 191). -/
theorem vaultReachCountBody {σ σ₀ A I} {g : Sat256} (v : VaultImmutables)
    (hcode : I.code = deployedRuntime v) (hwv : I.weiValue = ⟨0⟩) (hsz : 4 ≤ I.calldata.size) (hsize : I.calldata.size < UInt256.size)
    (hsel : selIs I (vaultSelBytes 1)) :
    ∃ k C, RD (deployedRuntime v) I g (initState σ σ₀ g A I) (UInt256.ofNat 191)
      [(UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes (⟨0⟩ : UInt256).toNat 32)) (UInt256.ofNat 224))]
      ((UInt256.ofNat 128).toByteArray.write 0 ByteArray.empty (UInt256.ofNat 64).toNat 32)
      (M (UInt256.ofNat 0) (UInt256.ofNat 64) (⟨32⟩ : UInt256)) ByteArray.empty σ k C := by
  have hword : solcSelectorWord I = ⟨107354813⟩ :=
    solcSelectorWord_eq_of_beq I hsz 0x06 0x66 0x1a 0xbd ⟨107354813⟩ (by native_decide)
      (by simpa [vaultSelBytes] using hsel)
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  have rd1 := vaultBlocks.vault_block_0_taken (immWords := wordsOf (immStore v)) (by simp) (by first | (rw [hwv]; decide) | exact isZero_eq_zero_of_ne hwv | exact hwv | simpa using hwv) (by rw [vaultPatchedValidJumpsRuntime v]; jump_dest) rd0
  have rd2 := vaultBlocks.vault_block_15_fallthrough (immWords := wordsOf (immStore v)) (by simp [vaultBlocks.vault_block_0_taken_stack, vaultBlocks.vault_block_0_taken_memory]) (by first | exact lt_four_eq_zero_of_ge hsz hsize | exact lt_four_ne_zero_of_lt hshort | exact isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort) | (rw [lt_four_eq_zero_of_ge hsz hsize]; decide) | (rw [isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort)]; decide)) rd1
  have rd3 := vaultBlocks.vault_block_25_taken (immWords := wordsOf (immStore v)) (by simp [vaultBlocks.vault_block_0_taken_stack, vaultBlocks.vault_block_0_taken_memory, vaultBlocks.vault_block_15_fallthrough_stack]) (by simpa [solcSelectorWord] using (show (UInt256.gt ⟨773487949⟩ (solcSelectorWord I)) ≠ ⟨0⟩ by rw [hword]; native_decide)) (by rw [vaultPatchedValidJumpsRuntime v]; jump_dest) rd2
