/-! ## Solm dispatch: which transition a selector reaches -/

theorem vaultDispatch_sweep {I : ExecutionEnv} 
    (hsel : selIs I (vaultSelBytes 0)) :
    dispatchMsg contract I.calldata = some sweepTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [countTransition, feeBpsTransition, balancesTransition, totalTransition, withdrawTransition, dropLastTransition, ownerTransition, depositTransition, depositorsTransition, tokenTransition])
    (ti := sweepTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [sweepSelectorOf]; exact hsel

theorem vaultDispatch_count {I : ExecutionEnv} (h0 : ¬ selIs I (vaultSelBytes 0))
    (hsel : selIs I (vaultSelBytes 1)) :
    dispatchMsg contract I.calldata = some countTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := [sweepTransition]) (post := [feeBpsTransition, balancesTransition, totalTransition, withdrawTransition, dropLastTransition, ownerTransition, depositTransition, depositorsTransition, tokenTransition])
    (ti := countTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hu
    rcases hu with rfl
    · rw [sweepSelectorOf]; exact Bool.eq_false_of_not_eq_true h0
  · rw [countSelectorOf]; exact hsel

