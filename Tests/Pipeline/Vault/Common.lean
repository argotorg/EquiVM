/-! ## Selector words as the dispatcher compares them -/

theorem sweepEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨23599714⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (vaultSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x01 0x68 0x1a 0x62 ⟨23599714⟩ (by decide)

