/-- The transition list as its handles. -/
theorem transitions_eq : contract.transitions = [sweepTransition, countTransition, feeBpsTransition, balancesTransition, totalTransition, withdrawTransition, dropLastTransition, ownerTransition, depositTransition, depositorsTransition, tokenTransition] := by
  first | rfl | simp [contract, Syntax.contractSyntax]

/-! ## Selector bridges: each transition's signature hashes to its table entry -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
/-- `selectorOf sweepTransition = vaultSelBytes 0` (`sweep(address)`). -/
theorem sweepSelectorOf : selectorOf sweepTransition = vaultSelBytes 0 := by
  have hsig : transitionSigStr sweepTransition = "sweep(address)" := by
    simp [transitionSigStr, ABI.printSignature, transitionSignature, sweepTransition, contract,
      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact sweepSelectorFact

