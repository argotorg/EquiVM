/-! ## Immutables: the valuation's store, its words, and the deployed runtime -/

/-- The immutables a contract deployed with `v` runs with. -/
def immStore (v : VaultImmutables) : Store :=
  (((∅ : Store).insert "feeBps" (.int (Int.ofNat v.feeBps.toNat))).insert "owner" (.address v.owner))

@[simp] theorem immStore_get_feeBps (v : VaultImmutables) :
    (immStore v).get? "feeBps" = some (.int (Int.ofNat v.feeBps.toNat)) := by
  grind [immStore]

@[simp] theorem wordsOf_immStore_feeBps (v : VaultImmutables) :
    wordsOf (immStore v) "feeBps" = EVM.wordOfInt (Int.ofNat v.feeBps.toNat) :=
  wordsOf_of_get (immStore_get_feeBps v) rfl

@[simp] theorem immStore_get_owner (v : VaultImmutables) :
    (immStore v).get? "owner" = some (.address v.owner) := by
  grind [immStore]

@[simp] theorem wordsOf_immStore_owner (v : VaultImmutables) :
    wordsOf (immStore v) "owner" = EVM.Word.ofNat (↑v.owner : Nat) :=
  wordsOf_of_get (immStore_get_owner v) rfl

/-- The runtime deployed with the immutables `v`. -/
def deployedRuntime (v : VaultImmutables) : ByteArray :=
  immutableLayout.deployed vaultBytecode (immStore v)

theorem evalImmutable_feeBps (cfg : Config) (C : ContractDecl) (locals : Store) (evm : EVM.State)
    (v : VaultImmutables) :
    evalExpr? cfg { contract := C, locals := locals, immutables := immStore v } evm
      (.immutable "feeBps") = .ok (.int (Int.ofNat v.feeBps.toNat)) := by
  simp only [evalExpr?, immStore_get_feeBps, EvalResult.ofOption]

theorem evalImmutable_owner (cfg : Config) (C : ContractDecl) (locals : Store) (evm : EVM.State)
    (v : VaultImmutables) :
    evalExpr? cfg { contract := C, locals := locals, immutables := immStore v } evm
      (.immutable "owner") = .ok (.address v.owner) := by
  simp only [evalExpr?, immStore_get_owner, EvalResult.ofOption]

/-- Every patch site is a declared immutable. -/
theorem immutableLayout_keys :
    ∀ site ∈ immutableLayout.sites, site.2.2 ∈ contract.immutables.map (·.name) := by
  decide

/-- A well-typed immutables store runs as the store of some valuation. -/
theorem restrictImmutables_of_fit {imms : Store} (h : immutablesFit contract imms) :
    ∃ v, restrictImmutables contract imms = immStore v := by
  sorry  -- TODO: case on each immutable's value as in Examples/TinyImmutable/Common.lean

/-- The patched runtime has the template's jump destinations (patch sites are push payloads). -/
theorem vaultPatchedValidJumps (v : VaultImmutables) :
    D_J (deployedRuntime v) 0 = D_J vaultBytecode 0 :=
  Layout.D_J_runtime (by native_decide) (by native_decide)

/-- The same fact in the form the block summaries state the code in. -/
theorem vaultPatchedValidJumpsRuntime (v : VaultImmutables) :
    D_J (immutableLayout.runtime vaultBytecode (wordsOf (immStore v))) 0 = D_J vaultBytecode 0 :=
  vaultPatchedValidJumps v

