import Solidity.Test.Harness
import Solidity.Test.Specs.Lazy
import Solidity.Test.Fixtures.LazySolc

/-! # Differential cases: calldata arrays and structs with dynamic content.

A `bytes[]`, `string[]`, `uint8[][]`, `bytes[][]`, `bytes[2]` or `D[]` calldata parameter (`D` a
struct with a `bytes` field), and such a `D`: solc checks an element's offset and length when the
element is used, copies to memory through its decoder and encodes through the element access.
`Lazy` holds the well-formed calls (fuzzed); `Lazy/boundaries` runs every operation against
malformed inner and outer headers: an inner offset of `2^255` (it passes solc's signed comparison
and reads a zero length), `2^64`, `2^64 - 1` and `0x4000` (beyond the data), inner lengths of
`2^200`, `2^64` and 1000, an outer length of 3 (one head slot too many) and 100, and truncated
data.  The expectations are the EVM's results. -/

namespace Solidity.Test.Lazy

open Solidity.Test Ethereum

def runtime : ByteArray := bytesOfHex Fixtures.lazyRuntimeHex

def words (ws : List Nat) : ByteArray := ws.foldl (fun b w => b ++ wordBytes w) ByteArray.empty

/-- A call with the argument words as given and the expected outcome. -/
def rcE (sig : String) (ws : List Nat) (tag : String) (e : Expect) : Case :=
  { name := s!"{sig} {tag}", code := runtime, calldata := selectorOfSig sig ++ words ws, expect := e }

