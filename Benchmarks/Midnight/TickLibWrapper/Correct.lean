open Stele ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach

namespace Benchmarks.Midnight.TickLibWrapper

set_option maxRecDepth 2000000

theorem tickLibWrapperNoDispatch {σ σ₀ A I} {g : UInt256}
    (hcode : I.code = tickLibWrapperBytecode) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 6 → (tickLibWrapperSelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I := by
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (tickLibWrapperX_noMatch (g := Sat256.ofUInt256 g) hcode hsz hsize hnm)
      |>.reEquivNoDispatch hcode (tickLibWrapperDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (tickLibWrapperX_short (g := Sat256.ofUInt256 g) hcode hshort)
      |>.reEquivNoDispatch hcode (tickLibWrapperDispatch_none_short hshort)

theorem tickLibWrapperNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (tickLibWrapperSelBytes 0)) (h1 : ¬ selIs I (tickLibWrapperSelBytes 1)) (h2 : ¬ selIs I (tickLibWrapperSelBytes 2)) (h3 : ¬ selIs I (tickLibWrapperSelBytes 3)) (h4 : ¬ selIs I (tickLibWrapperSelBytes 4)) (h5 : ¬ selIs I (tickLibWrapperSelBytes 5)) :
    ∀ i, i < 6 → (tickLibWrapperSelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3
  · simpa [selIs] using h4
  · simpa [selIs] using h5

theorem tickLibWrapperCorrect :
    runtimeRefinement config (tickLibWrapperBytecode) contract := by
  refine ⟨fun σ σ₀ g A I hcode hsize ↦ ?_⟩
  by_cases h0 : selIs I (tickLibWrapperSelBytes 0)
  · exact tickLibWrapperPriceRoundingStepBody hcode hsize h0
  · by_cases h1 : selIs I (tickLibWrapperSelBytes 1)
    · exact tickLibWrapperMaxTickBody hcode hsize h1
    · by_cases h2 : selIs I (tickLibWrapperSelBytes 2)
      · exact tickLibWrapperTickToPriceBody hcode hsize h2
      · by_cases h3 : selIs I (tickLibWrapperSelBytes 3)
        · exact tickLibWrapperPriceToTickBody hcode hsize h3
        · by_cases h4 : selIs I (tickLibWrapperSelBytes 4)
          · exact tickLibWrapperLnOnePlusDeltaBody hcode hsize h4
          · by_cases h5 : selIs I (tickLibWrapperSelBytes 5)
            · exact tickLibWrapperWExpBody hcode hsize h5
            · exact tickLibWrapperNoDispatch hcode hsize (tickLibWrapperNoSelectorMatches h0 h1 h2 h3 h4 h5)

theorem tickLibWrapperContractCorrect :
    contractRefinement config tickLibWrapperCreationBytecode contract :=
  contractRefinement.of_constant tickLibWrapperConstructorCorrect tickLibWrapperCorrect

end Benchmarks.Midnight.TickLibWrapper
