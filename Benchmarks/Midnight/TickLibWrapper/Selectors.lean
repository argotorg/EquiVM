import Ethereum.Semantics

/-!
# TickLibWrapper selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Stele transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace Benchmarks.Midnight.TickLibWrapper

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev tickLibWrapperSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (6 entries). -/
def tickLibWrapperSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x00, 0xb6, 0xda, 0x9b]⟩  -- priceRoundingStep()
  | 1 => ⟨#[0x1d, 0xb3, 0xb6, 0xdd]⟩  -- maxTick()
  | 2 => ⟨#[0x28, 0x39, 0x94, 0x9b]⟩  -- tickToPrice(uint256)
  | 3 => ⟨#[0x3c, 0x40, 0x4b, 0x1a]⟩  -- priceToTick(uint256,uint256)
  | 4 => ⟨#[0x6b, 0xa3, 0xf4, 0x74]⟩  -- lnOnePlusDelta()
  | _ => ⟨#[0xee, 0x13, 0x84, 0xba]⟩  -- wExp(int256)

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("priceRoundingStep()")[0:4] = 0x00b6da9b`. -/
theorem priceRoundingStepSelectorFact :
    (Ethereum.KEC (String.toByteArray "priceRoundingStep()")).extract 0 4 = tickLibWrapperSelBytes 0 := by
  decide +kernel

/-- `keccak256("maxTick()")[0:4] = 0x1db3b6dd`. -/
theorem maxTickSelectorFact :
    (Ethereum.KEC (String.toByteArray "maxTick()")).extract 0 4 = tickLibWrapperSelBytes 1 := by
  decide +kernel

/-- `keccak256("tickToPrice(uint256)")[0:4] = 0x2839949b`. -/
theorem tickToPriceSelectorFact :
    (Ethereum.KEC (String.toByteArray "tickToPrice(uint256)")).extract 0 4 = tickLibWrapperSelBytes 2 := by
  decide +kernel

/-- `keccak256("priceToTick(uint256,uint256)")[0:4] = 0x3c404b1a`. -/
theorem priceToTickSelectorFact :
    (Ethereum.KEC (String.toByteArray "priceToTick(uint256,uint256)")).extract 0 4 = tickLibWrapperSelBytes 3 := by
  decide +kernel

/-- `keccak256("lnOnePlusDelta()")[0:4] = 0x6ba3f474`. -/
theorem lnOnePlusDeltaSelectorFact :
    (Ethereum.KEC (String.toByteArray "lnOnePlusDelta()")).extract 0 4 = tickLibWrapperSelBytes 4 := by
  decide +kernel

/-- `keccak256("wExp(int256)")[0:4] = 0xee1384ba`. -/
theorem wExpSelectorFact :
    (Ethereum.KEC (String.toByteArray "wExp(int256)")).extract 0 4 = tickLibWrapperSelBytes 5 := by
  decide +kernel

end Benchmarks.Midnight.TickLibWrapper
