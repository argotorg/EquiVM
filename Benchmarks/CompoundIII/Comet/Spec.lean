/-! ## External-call ABI (from the translator's call facts; check against the callee ABIs) -/

def selectorBytes (a b c d : UInt8) : ByteArray := ⟨#[a, b, c, d]⟩

def externalABI : ExternalCallABI where
  encode? := fun name args =>
    if False then none
    else if name = "latestRoundData" then  -- latestRoundData()
      ABI.encodeCallWithSelector? (selectorBytes 0xfe 0xaf 0x96 0x8c) [] args
    else if name = "balanceOf" then  -- balanceOf(address)
      ABI.encodeCallWithSelector? (selectorBytes 0x70 0xa0 0x82 0x31) [(.elem .address)] args
    else if name = "approve" then  -- approve(address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0x09 0x5e 0xa7 0xb3) [(.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else if name = "decimals" then  -- decimals()
      ABI.encodeCallWithSelector? (selectorBytes 0x31 0x3c 0xe5 0x67) [] args
    else if name = "assetListFactory" then  -- assetListFactory()
      ABI.encodeCallWithSelector? (selectorBytes 0x70 0x42 0xe2 0xd8) [] args
    else if name = "transferFrom" then  -- transferFrom(address,address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0x23 0xb8 0x72 0xdd) [(.elem .address), (.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else if name = "transfer" then  -- transfer(address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0xa9 0x05 0x9c 0xbb) [(.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else none
  decode? := fun name out =>
    if False then none
    else if name = "balanceOf" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "approve" then some []
    else if name = "decimals" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem (.int (.uint ⟨8, by decide⟩))) out).map (fun v => [v])
    else if name = "assetListFactory" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem .address) out).map (fun v => [v])
    else if name = "transferFrom" then some []
    else if name = "transfer" then some []
    else none

