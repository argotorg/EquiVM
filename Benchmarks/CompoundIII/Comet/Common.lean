/-! ## Selector words as the dispatcher compares them -/

theorem isLiquidatableEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨70124239⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (cometWithExtendedAssetListSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
