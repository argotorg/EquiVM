theorem tickFeeWritesTrace {I : ExecutionEnv} {g : Sat256} {s0 evm : State}
    {mem rdata : ByteArray} {aw id x0 x1 : UInt256} {tick : Int} {k C : Nat} {R : List UInt256}
    (v : PoolManagerImmutables) (upper : Bool) (hstack : R.length+6 ≤ 1024)
    (hI : evm.executionEnv = I) (hm : memLoad (UInt256.ofNat 128) mem = poolSlot id)
    (h : RD (deployedRuntime v) I g s0 (if upper then ⟨7634⟩ else ⟨7685⟩)
      (x0 :: x1 :: tickSlot id tick :: R) mem aw rdata evm.accountMap k C) :
    if I.perm = false then RDstatic (deployedRuntime v) g s0 else ∃ k' C',
      RD (deployedRuntime v) I g s0 (if upper then ⟨7132⟩ else ⟨7679⟩)
        (x0 :: x1 :: tickSlot id tick :: R) mem
        (M (M aw (UInt256.ofNat 128) ⟨32⟩) (UInt256.ofNat 128) ⟨32⟩)
        rdata (tickFeeWrites evm id tick).accountMap k' C' := by
  by_cases hp : I.perm = false
  · rw [if_pos hp]
    cases upper
    · exact tickFeeStatic7685 hstack hp h
    · exact tickFeeStatic7634 hstack hp h
  · rw [if_neg hp]
    rw [tickFeeWrites_accounts hI id tick]
    cases upper
    · obtain ⟨k', C', rd⟩ := poolManagerBlocks.poolManager_block_7685 hstack
        (Bool.eq_true_of_not_eq_false hp) (by rw [poolManagerPatchedValidJumpsRuntime v]; jump_dest) h
      rw [hm] at rd
      exact ⟨k', C', rd⟩
    · obtain ⟨k', C', rd⟩ := poolManagerBlocks.poolManager_block_7634 hstack
        (Bool.eq_true_of_not_eq_false hp) (by rw [poolManagerPatchedValidJumpsRuntime v]; jump_dest) h
      rw [hm] at rd
      exact ⟨k', C', rd⟩

