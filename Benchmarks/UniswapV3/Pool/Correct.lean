theorem uniswapV3PoolRuntimeCorrect (imms : Store) (hfit : immutablesFit contract imms) :
    runtimeRefinement config (immutableLayout.deployed uniswapV3PoolBytecode imms) contract
      (restrictImmutables contract imms) := by
  obtain ⟨v, hv⟩ := restrictImmutables_of_fit hfit
  rw [← Reasoning.Immutables.Layout.deployed_restrict immutableLayout_keys, hv]
  exact uniswapV3PoolCorrect v

theorem uniswapV3PoolContractCorrect :
    contractRefinement config uniswapV3PoolCreationBytecode contract :=
  .of_runtime uniswapV3PoolConstructorCorrect uniswapV3PoolRuntimeCorrect

