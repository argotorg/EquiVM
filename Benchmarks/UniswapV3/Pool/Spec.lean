/-! ## External-call ABI (from the translator's call facts; check against the callee ABIs) -/

def selectorBytes (a b c d : UInt8) : ByteArray := ⟨#[a, b, c, d]⟩

def externalABI : ExternalCallABI where
  encode? := fun name args =>
    if False then none
    else if name = "uniswapV3MintCallback" then  -- uniswapV3MintCallback(uint256,uint256,bytes)
      ABI.encodeCallWithSelector? (selectorBytes 0xd3 0x48 0x79 0x97) [(.elem (.int (.uint ⟨256, by decide⟩))), (.elem (.int (.uint ⟨256, by decide⟩))), .bytes] args
    else if name = "uniswapV3SwapCallback" then  -- uniswapV3SwapCallback(int256,int256,bytes)
      ABI.encodeCallWithSelector? (selectorBytes 0xfa 0x46 0x1e 0x33) [(.elem (.int (.sint ⟨256, by decide⟩))), (.elem (.int (.sint ⟨256, by decide⟩))), .bytes] args
    else if name = "uniswapV3FlashCallback" then  -- uniswapV3FlashCallback(uint256,uint256,bytes)
      ABI.encodeCallWithSelector? (selectorBytes 0xe9 0xcb 0xaf 0xb0) [(.elem (.int (.uint ⟨256, by decide⟩))), (.elem (.int (.uint ⟨256, by decide⟩))), .bytes] args
    else if name = "balanceOf" then  -- balanceOf(address)
      ABI.encodeCallWithSelector? (selectorBytes 0x70 0xa0 0x82 0x31) [(.elem .address)] args
    else if name = "transfer" then  -- transfer(address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0xa9 0x05 0x9c 0xbb) [(.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else none
  decode? := fun name out =>
    if False then none
    else if name = "uniswapV3MintCallback" then some []
    else if name = "uniswapV3SwapCallback" then some []
    else if name = "uniswapV3FlashCallback" then some []
    else if name = "balanceOf" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem (.int (.uint ⟨256, by decide⟩))) out).map (fun v => [v])
    else if name = "transfer" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem .bool) out).map (fun v => [v])
    else none

/-! ## Config -/

def config : Config :=
  { storageBackend := storageBackend
    externalABI := externalABI
    abiDecodeMode := DecodeMode.legacySolc05
    selfDeployment := genSolidityConstructorDeployment contract.ctor.params }

