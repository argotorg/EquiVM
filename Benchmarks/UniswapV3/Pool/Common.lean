      Syntax.contractSyntax, ABI.abiToSigStr, ABI.elemToSigStr, ABI.intTypeToSigStr, show Nat.repr 8 = "8" by decide +kernel, show Nat.repr 16 = "16" by decide +kernel, show Nat.repr 24 = "24" by decide +kernel, show Nat.repr 32 = "32" by decide +kernel, show Nat.repr 128 = "128" by decide +kernel, show Nat.repr 160 = "160" by decide +kernel, show Nat.repr 256 = "256" by decide +kernel]
      <;> decide +kernel
  unfold selectorOf
  rw [hsig]
  exact initializeSelectorFact

