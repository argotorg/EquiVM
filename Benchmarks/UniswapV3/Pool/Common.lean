/-- The runtime deployed with the immutables `v`. -/
def deployedRuntime (v : UniswapV3PoolImmutables) : ByteArray :=
  immutableLayout.deployed uniswapV3PoolBytecode (immStore v)

theorem evalImmutable_factory (cfg : Config) (C : ContractDecl) (locals : Store) (evm : EVM.State)
    (v : UniswapV3PoolImmutables) :
    evalExpr? cfg { contract := C, locals := locals, immutables := immStore v } evm
      (.immutable "factory") = .ok (.address v.factory) := by
  simp only [evalExpr?, immStore_get_factory, EvalResult.ofOption]

