/-! ## Immutables: the valuation's store, its words, and the deployed runtime -/

/-- The immutables a contract deployed with `v` runs with. -/
def immStore (v : EASImmutables) : Store :=
  ((((((((∅ : Store).insert "_CACHED_DOMAIN_SEPARATOR" (.int (Int.ofNat v._CACHED_DOMAIN_SEPARATOR.toNat))).insert "_CACHED_CHAIN_ID" (.int (Int.ofNat v._CACHED_CHAIN_ID.toNat))).insert "_CACHED_THIS" (.address v._CACHED_THIS)).insert "_HASHED_NAME" (.int (Int.ofNat v._HASHED_NAME.toNat))).insert "_HASHED_VERSION" (.int (Int.ofNat v._HASHED_VERSION.toNat))).insert "_TYPE_HASH" (.int (Int.ofNat v._TYPE_HASH.toNat))).insert "_schemaRegistry" (.address v._schemaRegistry))

@[simp] theorem immStore_get__CACHED_DOMAIN_SEPARATOR (v : EASImmutables) :
    (immStore v).get? "_CACHED_DOMAIN_SEPARATOR" = some (.int (Int.ofNat v._CACHED_DOMAIN_SEPARATOR.toNat)) := by
  simp only [immStore, Std.HashMap.get?_eq_getElem?, Std.HashMap.getElem?_insert]
  rfl

@[simp] theorem wordsOf_immStore__CACHED_DOMAIN_SEPARATOR (v : EASImmutables) :
    wordsOf (immStore v) "_CACHED_DOMAIN_SEPARATOR" = EVM.wordOfInt (Int.ofNat v._CACHED_DOMAIN_SEPARATOR.toNat) :=
  wordsOf_of_get (immStore_get__CACHED_DOMAIN_SEPARATOR v) rfl

