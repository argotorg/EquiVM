/-- The runtime deployed with the immutables `v`. -/
def deployedRuntime (v : EASImmutables) : ByteArray :=
  immutableLayout.deployed easBytecode (immStore v)

theorem evalImmutable__CACHED_DOMAIN_SEPARATOR (cfg : Config) (C : ContractDecl) (locals : Store) (evm : EVM.State)
    (v : EASImmutables) :
    evalExpr? cfg { contract := C, locals := locals, immutables := immStore v } evm
      (.immutable "_CACHED_DOMAIN_SEPARATOR") = .ok (.int (Int.ofNat v._CACHED_DOMAIN_SEPARATOR.toNat)) := by
  simp only [evalExpr?, immStore_get__CACHED_DOMAIN_SEPARATOR, EvalResult.ofOption]

