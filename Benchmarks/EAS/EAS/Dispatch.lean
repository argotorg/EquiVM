theorem easDispatch_getAttestTypeHash {I : ExecutionEnv} 
    (hsel : selIs I (easSelBytes 0)) :
    dispatchMsg contract I.calldata = some getAttestTypeHashTransition := by
  refine dispatchMsg_eq_some_of_split (contract := contract)
    (pre := []) (post := [multiRevokeOffchainTransition, getNonceTransition, multiAttestTransition, revokeTransition, multiRevokeTransition, timestampTransition, multiAttestByDelegationTransition, getAttestationTransition, getRevokeOffchainTransition, getRevokeTypeHashTransition, revokeOffchainTransition, getTimestampTransition, attestByDelegationTransition, isAttestationValidTransition, multiRevokeByDelegationTransition, revokeByDelegationTransition, multiTimestampTransition, getDomainSeparatorTransition, getSchemaRegistryTransition, attestTransition, vERSIONTransition])
    (ti := getAttestTypeHashTransition) (cd := I.calldata) (by rfl) ?_ ?_ ?_ (by rfl)
  · exact transitions_eq
  · intro u hu
    simp at hu
  · rw [getAttestTypeHashSelectorOf]; exact hsel

