import Ethereum.Semantics

/-!
# EAS selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Solm transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace Benchmarks.EAS.EAS

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev easSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (22 entries). -/
def easSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x12, 0xb1, 0x1a, 0x17]⟩  -- getAttestTypeHash()
  | 1 => ⟨#[0x13, 0x89, 0x3f, 0x61]⟩  -- multiRevokeOffchain(bytes32[])
  | 2 => ⟨#[0x2d, 0x03, 0x35, 0xab]⟩  -- getNonce(address)
  | 3 => ⟨#[0x44, 0xad, 0xc9, 0x0e]⟩  -- multiAttest((bytes32,(address,uint64,bool,bytes32,bytes,uint256)[])[])
  | 4 => ⟨#[0x46, 0x92, 0x62, 0x67]⟩  -- revoke((bytes32,(bytes32,uint256)))
  | 5 => ⟨#[0x4c, 0xb7, 0xe9, 0xe5]⟩  -- multiRevoke((bytes32,(bytes32,uint256)[])[])
  | 6 => ⟨#[0x4d, 0x00, 0x30, 0x70]⟩  -- timestamp(bytes32)
  | 7 => ⟨#[0x83, 0x1e, 0x05, 0xa1]⟩  -- multiAttestByDelegation((bytes32,(address,uint64,bool,bytes32,bytes,uint256)[],(uint8,bytes32,bytes32)[],address)[])
  | 8 => ⟨#[0xa3, 0x11, 0x2a, 0x64]⟩  -- getAttestation(bytes32)
  | 9 => ⟨#[0xb4, 0x69, 0x31, 0x8d]⟩  -- getRevokeOffchain(address,bytes32)
  | 10 => ⟨#[0xb8, 0x30, 0x10, 0xd3]⟩  -- getRevokeTypeHash()
  | 11 => ⟨#[0xcf, 0x19, 0x0f, 0x34]⟩  -- revokeOffchain(bytes32)
  | 12 => ⟨#[0xd4, 0x5c, 0x44, 0x35]⟩  -- getTimestamp(bytes32)
  | 13 => ⟨#[0xe1, 0x34, 0x58, 0xfc]⟩  -- attestByDelegation((bytes32,(address,uint64,bool,bytes32,bytes,uint256),(uint8,bytes32,bytes32),address))
  | 14 => ⟨#[0xe3, 0x0b, 0xb5, 0x63]⟩  -- isAttestationValid(bytes32)
  | 15 => ⟨#[0xe4, 0x5d, 0x03, 0xf9]⟩  -- multiRevokeByDelegation((bytes32,(bytes32,uint256)[],(uint8,bytes32,bytes32)[],address)[])
  | 16 => ⟨#[0xe5, 0x7a, 0x6b, 0x1b]⟩  -- revokeByDelegation((bytes32,(bytes32,uint256),(uint8,bytes32,bytes32),address))
  | 17 => ⟨#[0xe7, 0x1f, 0xf3, 0x65]⟩  -- multiTimestamp(bytes32[])
  | 18 => ⟨#[0xed, 0x24, 0x91, 0x1d]⟩  -- getDomainSeparator()
  | 19 => ⟨#[0xf1, 0x0b, 0x5c, 0xc8]⟩  -- getSchemaRegistry()
  | 20 => ⟨#[0xf1, 0x73, 0x25, 0xe7]⟩  -- attest((bytes32,(address,uint64,bool,bytes32,bytes,uint256)))
  | _ => ⟨#[0xff, 0xa1, 0xad, 0x74]⟩  -- VERSION()

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("getAttestTypeHash()")[0:4] = 0x12b11a17`. -/
theorem getAttestTypeHashSelectorFact :
    (Ethereum.KEC (String.toByteArray "getAttestTypeHash()")).extract 0 4 = easSelBytes 0 := by
  decide +kernel

