/-! ## Storage backend: solc's layout for the declared storage -/

def storageBackend : StorageBackend := solidityStorage! [contract.structs] [contract.storage]

/-! ## External-call ABI (from the translator's call facts; check against the callee ABIs) -/

def selectorBytes (a b c d : UInt8) : ByteArray := ⟨#[a, b, c, d]⟩

def externalABI : ExternalCallABI where
  encode? := fun name args =>
    if False then none
    else if name = "isPayable" then  -- isPayable()
      ABI.encodeCallWithSelector? (selectorBytes 0xce 0x46 0xe0 0x46) [] args
    else if name = "sendValue" then  -- sendValue(address,uint256)
      ABI.encodeCallWithSelector? (selectorBytes 0x24 0xa0 0x84 0xdf) [(.elem .address), (.elem (.int (.uint ⟨256, by decide⟩)))] args
    else none
  decode? := fun name out =>
    if False then none
    else if name = "isPayable" then
      (ABI.decodeReturnValueWithMode? DecodeMode.modern (.elem .bool) out).map (fun v => [v])
    else if name = "sendValue" then some []
    else none

