/-!
# EAS correctness capstone (generated by `scripts/proof_skeleton.py`)

Thin top-level: the selector case split routes each selector to its per-function `…Body`
lemma, the shared revert paths close the rest, and the constructor is packaged into the
whole-contract refinement.
-/

open Solm ABI Ethereum Ethereum.EVM Reasoning.Theory Reasoning.Reach
open Reasoning.Immutables
open Benchmarks.EAS.EAS.Immutables

namespace Benchmarks.EAS.EAS

set_option maxRecDepth 2000000

theorem easNoDispatch {σ σ₀ A I} {g : UInt256} (v : EASImmutables)
    (hcode : I.code = deployedRuntime v) (hsize : I.calldata.size < UInt256.size)
    (hnm : ∀ i, i < 22 → (easSelBytes i == I.calldata.extract 0 4) = false) :
    runtimeRefinementFor config contract σ σ₀ g A I (immStore v) := by
  by_cases hsz : 4 ≤ I.calldata.size
  · exact (easX_noMatch (g := Sat256.ofUInt256 g) v hcode hsz hsize hnm)
      |>.reEquivNoDispatch hcode (easDispatch_none_nomatch hnm)
  · have hshort : I.calldata.size < 4 := by omega
    exact (easX_short (g := Sat256.ofUInt256 g) v hcode hshort)
      |>.reEquivNoDispatch hcode (easDispatch_none_short hshort)

theorem easNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (easSelBytes 0)) (h1 : ¬ selIs I (easSelBytes 1)) (h2 : ¬ selIs I (easSelBytes 2)) (h3 : ¬ selIs I (easSelBytes 3)) (h4 : ¬ selIs I (easSelBytes 4)) (h5 : ¬ selIs I (easSelBytes 5)) (h6 : ¬ selIs I (easSelBytes 6)) (h7 : ¬ selIs I (easSelBytes 7)) (h8 : ¬ selIs I (easSelBytes 8)) (h9 : ¬ selIs I (easSelBytes 9)) (h10 : ¬ selIs I (easSelBytes 10)) (h11 : ¬ selIs I (easSelBytes 11)) (h12 : ¬ selIs I (easSelBytes 12)) (h13 : ¬ selIs I (easSelBytes 13)) (h14 : ¬ selIs I (easSelBytes 14)) (h15 : ¬ selIs I (easSelBytes 15)) (h16 : ¬ selIs I (easSelBytes 16)) (h17 : ¬ selIs I (easSelBytes 17)) (h18 : ¬ selIs I (easSelBytes 18)) (h19 : ¬ selIs I (easSelBytes 19)) (h20 : ¬ selIs I (easSelBytes 20)) (h21 : ¬ selIs I (easSelBytes 21)) :
    ∀ i, i < 22 → (easSelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3
  · simpa [selIs] using h4
  · simpa [selIs] using h5
  · simpa [selIs] using h6
  · simpa [selIs] using h7
  · simpa [selIs] using h8
  · simpa [selIs] using h9
  · simpa [selIs] using h10
  · simpa [selIs] using h11
  · simpa [selIs] using h12
  · simpa [selIs] using h13
  · simpa [selIs] using h14
  · simpa [selIs] using h15
  · simpa [selIs] using h16
  · simpa [selIs] using h17
  · simpa [selIs] using h18
  · simpa [selIs] using h19
  · simpa [selIs] using h20
  · simpa [selIs] using h21

theorem easCorrect (v : EASImmutables) :
    runtimeRefinement config (deployedRuntime v) contract (immStore v) := by
  refine ⟨fun σ σ₀ g A I hcode hsize ↦ ?_⟩
  by_cases h0 : selIs I (easSelBytes 0)
  · exact easGetAttestTypeHashBody v hcode hsize h0
  · by_cases h1 : selIs I (easSelBytes 1)
    · exact easMultiRevokeOffchainBody v hcode hsize h1
    · by_cases h2 : selIs I (easSelBytes 2)
      · exact easGetNonceBody v hcode hsize h2
      · by_cases h3 : selIs I (easSelBytes 3)
        · exact easMultiAttestBody v hcode hsize h3
        · by_cases h4 : selIs I (easSelBytes 4)
          · exact easRevokeBody v hcode hsize h4
          · by_cases h5 : selIs I (easSelBytes 5)
            · exact easMultiRevokeBody v hcode hsize h5
            · by_cases h6 : selIs I (easSelBytes 6)
              · exact easTimestampBody v hcode hsize h6
              · by_cases h7 : selIs I (easSelBytes 7)
                · exact easMultiAttestByDelegationBody v hcode hsize h7
                · by_cases h8 : selIs I (easSelBytes 8)
                  · exact easGetAttestationBody v hcode hsize h8
                  · by_cases h9 : selIs I (easSelBytes 9)
                    · exact easGetRevokeOffchainBody v hcode hsize h9
                    · by_cases h10 : selIs I (easSelBytes 10)
                      · exact easGetRevokeTypeHashBody v hcode hsize h10
                      · by_cases h11 : selIs I (easSelBytes 11)
                        · exact easRevokeOffchainBody v hcode hsize h11
                        · by_cases h12 : selIs I (easSelBytes 12)
                          · exact easGetTimestampBody v hcode hsize h12
                          · by_cases h13 : selIs I (easSelBytes 13)
                            · exact easAttestByDelegationBody v hcode hsize h13
                            · by_cases h14 : selIs I (easSelBytes 14)
                              · exact easIsAttestationValidBody v hcode hsize h14
                              · by_cases h15 : selIs I (easSelBytes 15)
                                · exact easMultiRevokeByDelegationBody v hcode hsize h15
                                · by_cases h16 : selIs I (easSelBytes 16)
                                  · exact easRevokeByDelegationBody v hcode hsize h16
                                  · by_cases h17 : selIs I (easSelBytes 17)
                                    · exact easMultiTimestampBody v hcode hsize h17
                                    · by_cases h18 : selIs I (easSelBytes 18)
                                      · exact easGetDomainSeparatorBody v hcode hsize h18
                                      · by_cases h19 : selIs I (easSelBytes 19)
                                        · exact easGetSchemaRegistryBody v hcode hsize h19
                                        · by_cases h20 : selIs I (easSelBytes 20)
                                          · exact easAttestBody v hcode hsize h20
                                          · by_cases h21 : selIs I (easSelBytes 21)
                                            · exact easVERSIONBody v hcode hsize h21
                                            · exact easNoDispatch v hcode hsize (easNoSelectorMatches h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 h16 h17 h18 h19 h20 h21)

theorem easRuntimeCorrect (imms : Store) (hfit : immutablesFit contract imms) :
    runtimeRefinement config (immutableLayout.deployed easBytecode imms) contract
      (restrictImmutables contract imms) := by
  obtain ⟨v, hv⟩ := restrictImmutables_of_fit hfit
  rw [← Reasoning.Immutables.Layout.deployed_restrict immutableLayout_keys, hv]
  exact easCorrect v

theorem easContractCorrect :
    contractRefinement config easCreationBytecode contract :=
  .of_runtime easConstructorCorrect easRuntimeCorrect

end Benchmarks.EAS.EAS
