namespace Benchmarks.EAS.Attester.CreationBytecode

open Ethereum Ethereum.EVM EVM.Disassembly Reasoning.Disassembly Reasoning.Immutables

/-- The sections as a search tree, computed when this file is elaborated. -/
noncomputable def tree : EVM.Disassembly.Tree :=
  eval% EVM.Disassembly.Tree.ofSections (sectionsOf attesterCreationBytecode [])

def bytes : List UInt8 := attesterCreationBytecode.data.toList

/-- The sections with their offsets. -/
noncomputable def sections : List (Nat × List Instr) := tree.flat []

/-- The sections are the disassembly of the bytes. -/
theorem check : Checked bytes sections := by decide +kernel

/-- The bytecode has no immutables to fill in. -/
theorem code_eq : attesterCreationBytecode = filled bytes (fun _ => ⟨0⟩) sections :=
  eq_filled (by decide +kernel) _

/-- Sections before this offset end inside the code. -/
def lim : Nat := eval% limOf (sectionsOf attesterCreationBytecode []) attesterCreationBytecode.size

theorem inside : tailCheck sections bytes.length lim = true := by decide +kernel

/-- A section found in the tree decodes in the code followed by any `tail`. -/
theorem decodes_code (tail : ByteArray) {t : Nat} {s : List Instr} (h : tree.get? t = some s)
    (ht : t < lim := by decide) :
    Decodes (attesterCreationBytecode ++ tail) (fun _ => ⟨0⟩) (UInt256.ofNat t) s :=
  decodes_appended_tree check code_eq inside tail h ht

/-- The offset of a section that starts with a `JUMPDEST` is a valid jump destination of the
code followed by any `tail`. -/
theorem jumpdest_code (tail : ByteArray) {t : Nat} {s : List Instr} (h : tree.get? t = some s)
    (hjd : startsJD s = true) (ht : t < 2 ^ 256 := by decide) :
    (D_J (attesterCreationBytecode ++ tail) 0).contains (UInt256.ofNat t) = true :=
  jumpdest_appended_tree check code_eq tail h hjd ht

end Benchmarks.EAS.Attester.CreationBytecode
