noncomputable def tree : EVM.Disassembly.Tree :=
  eval% EVM.Disassembly.Tree.ofSections
    (sectionsOf attesterBytecode (siteNumbers Benchmarks.EAS.Attester.Immutables.immutableLayout.sites names))

def bytes : List UInt8 := attesterBytecode.data.toList

/-- The sections with their offsets. -/
noncomputable def sections : List (Nat × List Instr) := tree.flat []

/-- The sections are the disassembly of the bytes. -/
theorem check : Checked bytes sections := by decide +kernel

/-- The sites of the layout are the immutables of the sections. -/
theorem code_check :
    codeCheck Benchmarks.EAS.Attester.Immutables.immutableLayout.sites sections names = true := by decide +kernel

/-- The runtime code is the template with its immutables filled in. -/
theorem code_eq (immWords : String → UInt256) :
    (Benchmarks.EAS.Attester.Immutables.immutableLayout.runtime attesterBytecode immWords) = filled bytes (immσ names immWords) sections :=
  runtime_eq_filled check code_check immWords

/-- A section found in the tree decodes at its offset. -/
theorem decodes_code (immWords : String → UInt256) {t : Nat} {s : List Instr} (h : tree.get? t = some s) :
    Decodes (Benchmarks.EAS.Attester.Immutables.immutableLayout.runtime attesterBytecode immWords) (immσ names immWords) (UInt256.ofNat t) s :=
  decodes_tree check (code_eq immWords) h

/-- The offset of a section that starts with a `JUMPDEST` is a valid jump destination. -/
theorem jumpdest_code (immWords : String → UInt256) {t : Nat} {s : List Instr} (h : tree.get? t = some s)
    (hjd : startsJD s = true) (ht : t < 2 ^ 256 := by decide) :
    (D_J (Benchmarks.EAS.Attester.Immutables.immutableLayout.runtime attesterBytecode immWords) 0).contains (UInt256.ofNat t) = true :=
  jumpdest_tree check (code_eq immWords) h hjd ht

/-- The size of the template. -/
theorem _root_.attesterRuntimeBlocks.immutableTemplate_size :
    attesterBytecode.size = eval% attesterBytecode.size := by
  decide +kernel

theorem _root_.attesterRuntimeBlocks.immutableLayout_sites :
    Benchmarks.EAS.Attester.Immutables.immutableLayout.sites = eval% Benchmarks.EAS.Attester.Immutables.immutableLayout.sites := by decide

theorem _root_.attesterRuntimeBlocks.immutableLayout_inBounds :
    Benchmarks.EAS.Attester.Immutables.immutableLayout.inBounds attesterBytecode = true := by
  simp only [Layout.inBounds, attesterRuntimeBlocks.immutableTemplate_size, attesterRuntimeBlocks.immutableLayout_sites]
  decide

theorem _root_.attesterRuntimeBlocks.immutableTemplate_size64 : attesterBytecode.size < 2 ^ 64 := by
  rw [attesterRuntimeBlocks.immutableTemplate_size]; decide

theorem _root_.attesterRuntimeBlocks.immutableRuntime_size (immWords : String → Ethereum.UInt256) :
    (Benchmarks.EAS.Attester.Immutables.immutableLayout.runtime attesterBytecode immWords).size = attesterBytecode.size :=
  Layout.runtime_size_of_bounds attesterRuntimeBlocks.immutableLayout_inBounds

end Benchmarks.EAS.Attester.Bytecode
