/-! ## Immutables: the valuation's store, its words, and the deployed runtime -/

/-- The immutables a contract deployed with `v` runs with. -/
def immStore (v : MetaMorphoV1_1Immutables) : Store :=
  ((((((((((((∅ : Store).insert "_asset" (.address v._asset)).insert "_underlyingDecimals" (.int (Int.ofNat v._underlyingDecimals.toNat))).insert "_cachedDomainSeparator" (.int (Int.ofNat v._cachedDomainSeparator.toNat))).insert "_cachedChainId" (.int (Int.ofNat v._cachedChainId.toNat))).insert "_cachedThis" (.address v._cachedThis)).insert "_hashedName" (.int (Int.ofNat v._hashedName.toNat))).insert "_hashedVersion" (.int (Int.ofNat v._hashedVersion.toNat))).insert "_name" (.int (Int.ofNat v._name.toNat))).insert "_version" (.int (Int.ofNat v._version.toNat))).insert "MORPHO" (.address v.MORPHO)).insert "DECIMALS_OFFSET" (.int (Int.ofNat v.DECIMALS_OFFSET.toNat)))

@[simp] theorem immStore_get__asset (v : MetaMorphoV1_1Immutables) :
    (immStore v).get? "_asset" = some (.address v._asset) := by
  grind (gen := 33) [immStore]

@[simp] theorem wordsOf_immStore__asset (v : MetaMorphoV1_1Immutables) :
    wordsOf (immStore v) "_asset" = EVM.Word.ofNat (↑v._asset : Nat) :=
  wordsOf_of_get (immStore_get__asset v) rfl

