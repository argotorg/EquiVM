import Solm.DiffTest.Harness
import Benchmarks.Morpho.MorphoBlue.Spec
import Benchmarks.Morpho.MorphoBlue.Bytecode
import Benchmarks.Morpho.MorphoBlue.ImmutableCode

/-!
# Morpho differential-test target (generated by `scripts/scaffold.py difftest`)

Registered in `Tests/DiffTest/Generated.lean`; run with `lake exe solm-difftest --only Morpho`.
Adjust `callees` and `words` when the contract needs specific counterparties or amounts.
-/

open Solm Solm.DiffTest

namespace Benchmarks.Morpho.MorphoBlue

-- Constant-return fixtures still exercise EVM call boundaries, return decoding, and snapshots.
def morphoCallees : List (EVM.Address × ByteArray) :=
  [ (EVM.address 0x6000, callee (wordBytes 1000000000)), -- IRM: per-second rate
    (EVM.address 0x6001, callee (wordBytes (10 ^ 36))), -- oracle: unit collateral price
    (EVM.address 0x6002, callee (wordBytes 1)), -- ERC20 transfer/transferFrom: true
    (EVM.address 0x6003, callee .empty), -- ERC20 transfer/transferFrom: no return data
    (EVM.address 0x2000, callee .empty), -- callback receiver / caller
    (EVM.address 0x3000, callee .empty) ] ++ standardCallees

def diffTarget : Target :=
  { name := "Morpho", contract := contract, config := config, runtime := morphoBytecode,
    initcode := some morphoCreationBytecode,
    -- runtime cases use the store a generated constructor run leaves; the zero valuation
    -- is the fallback
    immutables := initialImmutables contract,
    runtimeCodeOf := some (immutableLayout.deployed morphoBytecode),
    deployedRuntime := true,
    callees := morphoCallees,
    words := [10 ^ 18, 10 ^ 36, 800000000000000000, 945000000000000000,
      250000000000000000, 1000000, 1000000000, 60, 3600, 86400,
      1700000000, 1700000060, 1700086400] }

end Benchmarks.Morpho.MorphoBlue
