/-! ## Selector words as the dispatcher compares them -/

theorem setOwnerEvmSelector {cd : ByteArray} (hsz : 4 ≤ cd.size) :
    UInt256.eq ⟨330252341⟩ (UInt256.shiftRight (uInt256OfByteArray (cd.readBytes 0 32)) ⟨224⟩)
      = if (morphoSelBytes 0 == cd.extract 0 4) then ⟨1⟩ else ⟨0⟩ :=
  evmSelectorDecode hsz 0x13 0xaf 0x40 0x35 ⟨330252341⟩ (by decide)

