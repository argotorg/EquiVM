/-! ## Immutables: the valuation's store, its words, and the deployed runtime -/

/-- The immutables a contract deployed with `v` runs with. -/
def immStore (v : MorphoImmutables) : Store :=
  ((∅ : Store).insert "DOMAIN_SEPARATOR" (.fixedBytes ⟨31, by decide⟩ (EVM.Word.toBytesBE v.DOMAIN_SEPARATOR)))

@[simp] theorem immStore_get_DOMAIN_SEPARATOR (v : MorphoImmutables) :
    (immStore v).get? "DOMAIN_SEPARATOR" = some (.fixedBytes ⟨31, by decide⟩ (EVM.Word.toBytesBE v.DOMAIN_SEPARATOR)) := by
  grind [immStore]

@[simp] theorem wordsOf_immStore_DOMAIN_SEPARATOR (v : MorphoImmutables) :
    wordsOf (immStore v) "DOMAIN_SEPARATOR" = v.DOMAIN_SEPARATOR :=
  wordsOf_of_get (immStore_get_DOMAIN_SEPARATOR v) (valueToWord_bytes32_word _)

/-- The runtime deployed with the immutables `v`. -/
def deployedRuntime (v : MorphoImmutables) : ByteArray :=
  immutableLayout.deployed morphoBytecode (immStore v)

theorem evalImmutable_DOMAIN_SEPARATOR (cfg : Config) (C : ContractDecl) (locals : Store) (evm : EVM.State)
    (v : MorphoImmutables) :
    evalExpr? cfg { contract := C, locals := locals, immutables := immStore v } evm
      (.immutable "DOMAIN_SEPARATOR") = .ok (.fixedBytes ⟨31, by decide⟩ (EVM.Word.toBytesBE v.DOMAIN_SEPARATOR)) := by
  simp only [evalExpr?, immStore_get_DOMAIN_SEPARATOR, EvalResult.ofOption]

/-- Every patch site is a declared immutable. -/
theorem immutableLayout_keys :
    ∀ site ∈ immutableLayout.sites, site.2.2 ∈ contract.immutables.map (·.name) := by
  decide

/-- A well-typed immutables store runs as the store of some valuation. -/
theorem restrictImmutables_of_fit {imms : Store} (h : immutablesFit contract imms) :
    ∃ v, restrictImmutables contract imms = immStore v := by
  sorry  -- TODO: case on each immutable's value as in Examples/TinyImmutable/Common.lean

/-- The patched runtime has the template's jump destinations (patch sites are push payloads). -/
theorem morphoPatchedValidJumps (v : MorphoImmutables) :
    D_J (deployedRuntime v) 0 = D_J morphoBytecode 0 :=
  Layout.D_J_runtime (by native_decide) (by native_decide)

/-- The same fact in the form the block summaries state the code in. -/
theorem morphoPatchedValidJumpsRuntime (v : MorphoImmutables) :
    D_J (immutableLayout.runtime morphoBytecode (wordsOf (immStore v))) 0 = D_J morphoBytecode 0 :=
  morphoPatchedValidJumps v

