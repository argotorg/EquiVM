import Ethereum.Semantics

/-!
# Morpho selectors

Generated by `scripts/scaffold.py lean`: the selector table in `contract.transitions` order,
the selector predicates, and one kernel-checked keccak fact per ABI signature.  The bridge from
each Solm transition's signature string to its entry (`transitionSigStr … = "…"`) is added by
the proof skeleton once `Spec.lean` exists.
-/

open Ethereum Ethereum.EVM

namespace Benchmarks.Morpho.MorphoBlue

/-- The 4-byte selector word computed by `CALLDATALOAD(0); SHR 224`. -/
abbrev morphoSelWord (I : ExecutionEnv) : UInt256 :=
  UInt256.shiftRight (uInt256OfByteArray (I.calldata.readBytes 0 32)) ⟨224⟩

/-- The 4-byte selector of `I`'s calldata equals `sel`. -/
abbrev selIs (I : ExecutionEnv) (sel : ByteArray) : Prop :=
  (sel == I.calldata.extract 0 4) = true

/-- Function selectors in `contract.transitions` order (28 entries). -/
def morphoSelBytes : ℕ → ByteArray
  | 0 => ⟨#[0x13, 0xaf, 0x40, 0x35]⟩  -- setOwner(address)
  | 1 => ⟨#[0x15, 0x1c, 0x1a, 0xde]⟩  -- accrueInterest((address,address,address,address,uint256))
  | 2 => ⟨#[0x20, 0xb7, 0x6e, 0x81]⟩  -- repay((address,address,address,address,uint256),uint256,uint256,address,bytes)
  | 3 => ⟨#[0x23, 0x8d, 0x65, 0x79]⟩  -- supplyCollateral((address,address,address,address,uint256),uint256,address,bytes)
  | 4 => ⟨#[0x2b, 0x4f, 0x01, 0x3c]⟩  -- setFee((address,address,address,address,uint256),uint256)
  | 5 => ⟨#[0x36, 0x44, 0xe5, 0x15]⟩  -- DOMAIN_SEPARATOR()
  | 6 => ⟨#[0x46, 0x90, 0x48, 0x40]⟩  -- feeRecipient()
  | 7 => ⟨#[0x4d, 0x98, 0xa9, 0x3b]⟩  -- enableLltv(uint256)
  | 8 => ⟨#[0x50, 0xd8, 0xcd, 0x4b]⟩  -- borrow((address,address,address,address,uint256),uint256,uint256,address,address)
  | 9 => ⟨#[0x5a, 0x64, 0xf5, 0x1e]⟩  -- enableIrm(address)
  | 10 => ⟨#[0x5c, 0x2b, 0xea, 0x49]⟩  -- withdraw((address,address,address,address,uint256),uint256,uint256,address,address)
  | 11 => ⟨#[0x65, 0xe4, 0xad, 0x9e]⟩  -- isAuthorized(address,address)
  | 12 => ⟨#[0x93, 0xc5, 0x20, 0x62]⟩  -- position(bytes32,address)
  | 13 => ⟨#[0x70, 0xae, 0x92, 0xd2]⟩  -- nonce(address)
  | 14 => ⟨#[0x77, 0x84, 0xc6, 0x85]⟩  -- extSloads(bytes32[])
  | 15 => ⟨#[0x87, 0x20, 0x31, 0x6d]⟩  -- withdrawCollateral((address,address,address,address,uint256),uint256,address,address)
  | 16 => ⟨#[0x8c, 0x13, 0x58, 0xa2]⟩  -- createMarket((address,address,address,address,uint256))
  | 17 => ⟨#[0x8d, 0xa5, 0xcb, 0x5b]⟩  -- owner()
  | 18 => ⟨#[0x2c, 0x3c, 0x91, 0x57]⟩  -- idToMarketParams(bytes32)
  | 19 => ⟨#[0xa9, 0x9a, 0xad, 0x89]⟩  -- supply((address,address,address,address,uint256),uint256,uint256,address,bytes)
  | 20 => ⟨#[0xb4, 0x85, 0xf3, 0xb8]⟩  -- isLltvEnabled(uint256)
  | 21 => ⟨#[0xd8, 0xea, 0xbc, 0xb8]⟩  -- liquidate((address,address,address,address,uint256),address,uint256,uint256,bytes)
  | 22 => ⟨#[0xe0, 0x23, 0x2b, 0x42]⟩  -- flashLoan(address,uint256,bytes)
  | 23 => ⟨#[0x5c, 0x60, 0xe3, 0x9a]⟩  -- market(bytes32)
  | 24 => ⟨#[0xe7, 0x4b, 0x98, 0x1b]⟩  -- setFeeRecipient(address)
  | 25 => ⟨#[0xee, 0xce, 0xa0, 0x00]⟩  -- setAuthorization(address,bool)
  | 26 => ⟨#[0xf2, 0xb8, 0x63, 0xce]⟩  -- isIrmEnabled(address)
  | _ => ⟨#[0x80, 0x69, 0x21, 0x8f]⟩  -- setAuthorizationWithSig((address,address,bool,uint256,uint256),(uint8,bytes32,bytes32))

set_option maxHeartbeats 0
set_option maxRecDepth 1000000

/-- `keccak256("setOwner(address)")[0:4] = 0x13af4035`. -/
theorem setOwnerSelectorFact :
    (Ethereum.KEC (String.toByteArray "setOwner(address)")).extract 0 4 = morphoSelBytes 0 := by
  decide +kernel

