set_option maxRecDepth 2000000

theorem morphoNoSelectorMatches {I : ExecutionEnv}
    (h0 : ¬ selIs I (morphoSelBytes 0)) (h1 : ¬ selIs I (morphoSelBytes 1)) (h2 : ¬ selIs I (morphoSelBytes 2)) (h3 : ¬ selIs I (morphoSelBytes 3)) (h4 : ¬ selIs I (morphoSelBytes 4)) (h5 : ¬ selIs I (morphoSelBytes 5)) (h6 : ¬ selIs I (morphoSelBytes 6)) (h7 : ¬ selIs I (morphoSelBytes 7)) (h8 : ¬ selIs I (morphoSelBytes 8)) (h9 : ¬ selIs I (morphoSelBytes 9)) (h10 : ¬ selIs I (morphoSelBytes 10)) (h11 : ¬ selIs I (morphoSelBytes 11)) (h12 : ¬ selIs I (morphoSelBytes 12)) (h13 : ¬ selIs I (morphoSelBytes 13)) (h14 : ¬ selIs I (morphoSelBytes 14)) (h15 : ¬ selIs I (morphoSelBytes 15)) (h16 : ¬ selIs I (morphoSelBytes 16)) (h17 : ¬ selIs I (morphoSelBytes 17)) (h18 : ¬ selIs I (morphoSelBytes 18)) (h19 : ¬ selIs I (morphoSelBytes 19)) (h20 : ¬ selIs I (morphoSelBytes 20)) (h21 : ¬ selIs I (morphoSelBytes 21)) (h22 : ¬ selIs I (morphoSelBytes 22)) (h23 : ¬ selIs I (morphoSelBytes 23)) (h24 : ¬ selIs I (morphoSelBytes 24)) (h25 : ¬ selIs I (morphoSelBytes 25)) (h26 : ¬ selIs I (morphoSelBytes 26)) (h27 : ¬ selIs I (morphoSelBytes 27)) :
    ∀ i, i < 28 → (morphoSelBytes i == I.calldata.extract 0 4) = false := by
  intro i hi
  interval_cases i
  · simpa [selIs] using h0
  · simpa [selIs] using h1
  · simpa [selIs] using h2
  · simpa [selIs] using h3
  · simpa [selIs] using h4
  · simpa [selIs] using h5
  · simpa [selIs] using h6
  · simpa [selIs] using h7
  · simpa [selIs] using h8
  · simpa [selIs] using h9
  · simpa [selIs] using h10
  · simpa [selIs] using h11
  · simpa [selIs] using h12
  · simpa [selIs] using h13
  · simpa [selIs] using h14
  · simpa [selIs] using h15
  · simpa [selIs] using h16
  · simpa [selIs] using h17
  · simpa [selIs] using h18
  · simpa [selIs] using h19
  · simpa [selIs] using h20
  · simpa [selIs] using h21
  · simpa [selIs] using h22
  · simpa [selIs] using h23
  · simpa [selIs] using h24
  · simpa [selIs] using h25
  · simpa [selIs] using h26
  · simpa [selIs] using h27

theorem morphoCorrect (v : MorphoImmutables) :
    runtimeRefinement config (deployedRuntime v) contract (immStore v) := by
  refine ⟨fun σ σ₀ g A I hcode hsize ↦ ?_⟩
  by_cases h0 : selIs I (morphoSelBytes 0)
  · exact morphoSetOwnerBody v hcode hsize h0
  · by_cases h1 : selIs I (morphoSelBytes 1)
    · exact morphoAccrueInterestBody v hcode hsize h1
    · by_cases h2 : selIs I (morphoSelBytes 2)
      · exact morphoRepayBody v hcode hsize h2
      · by_cases h3 : selIs I (morphoSelBytes 3)
        · exact morphoSupplyCollateralBody v hcode hsize h3
        · by_cases h4 : selIs I (morphoSelBytes 4)
          · exact morphoSetFeeBody v hcode hsize h4
          · by_cases h5 : selIs I (morphoSelBytes 5)
            · exact morphoDOMAIN_SEPARATORBody v hcode hsize h5
            · by_cases h6 : selIs I (morphoSelBytes 6)
              · exact morphoFeeRecipientBody v hcode hsize h6
              · by_cases h7 : selIs I (morphoSelBytes 7)
                · exact morphoEnableLltvBody v hcode hsize h7
                · by_cases h8 : selIs I (morphoSelBytes 8)
                  · exact morphoBorrowBody v hcode hsize h8
                  · by_cases h9 : selIs I (morphoSelBytes 9)
                    · exact morphoEnableIrmBody v hcode hsize h9
                    · by_cases h10 : selIs I (morphoSelBytes 10)
                      · exact morphoWithdrawBody v hcode hsize h10
                      · by_cases h11 : selIs I (morphoSelBytes 11)
                        · exact morphoIsAuthorizedBody v hcode hsize h11
                        · by_cases h12 : selIs I (morphoSelBytes 12)
                          · exact morphoPositionBody v hcode hsize h12
                          · by_cases h13 : selIs I (morphoSelBytes 13)
                            · exact morphoNonceBody v hcode hsize h13
                            · by_cases h14 : selIs I (morphoSelBytes 14)
                              · exact morphoExtSloadsBody v hcode hsize h14
                              · by_cases h15 : selIs I (morphoSelBytes 15)
                                · exact morphoWithdrawCollateralBody v hcode hsize h15
                                · by_cases h16 : selIs I (morphoSelBytes 16)
                                  · exact morphoCreateMarketBody v hcode hsize h16
                                  · by_cases h17 : selIs I (morphoSelBytes 17)
                                    · exact morphoOwnerBody v hcode hsize h17
                                    · by_cases h18 : selIs I (morphoSelBytes 18)
                                      · exact morphoIdToMarketParamsBody v hcode hsize h18
                                      · by_cases h19 : selIs I (morphoSelBytes 19)
                                        · exact morphoSupplyBody v hcode hsize h19
                                        · by_cases h20 : selIs I (morphoSelBytes 20)
                                          · exact morphoIsLltvEnabledBody v hcode hsize h20
                                          · by_cases h21 : selIs I (morphoSelBytes 21)
                                            · exact morphoLiquidateBody v hcode hsize h21
                                            · by_cases h22 : selIs I (morphoSelBytes 22)
                                              · exact morphoFlashLoanBody v hcode hsize h22
                                              · by_cases h23 : selIs I (morphoSelBytes 23)
                                                · exact morphoMarketBody v hcode hsize h23
                                                · by_cases h24 : selIs I (morphoSelBytes 24)
                                                  · exact morphoSetFeeRecipientBody v hcode hsize h24
                                                  · by_cases h25 : selIs I (morphoSelBytes 25)
                                                    · exact morphoSetAuthorizationBody v hcode hsize h25
                                                    · by_cases h26 : selIs I (morphoSelBytes 26)
                                                      · exact morphoIsIrmEnabledBody v hcode hsize h26
                                                      · by_cases h27 : selIs I (morphoSelBytes 27)
                                                        · exact morphoSetAuthorizationWithSigBody v hcode hsize h27
                                                        · exact morphoNoDispatch v hcode hsize (morphoNoSelectorMatches h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13 h14 h15 h16 h17 h18 h19 h20 h21 h22 h23 h24 h25 h26 h27)

theorem morphoRuntimeCorrect (imms : Store) (hfit : immutablesFit contract imms) :
    runtimeRefinement config (immutableLayout.deployed morphoBytecode imms) contract
      (restrictImmutables contract imms) := by
  obtain ⟨v, hv⟩ := restrictImmutables_of_fit hfit
  rw [← Reasoning.Immutables.Layout.deployed_restrict immutableLayout_keys, hv]
  exact morphoCorrect v

theorem morphoContractCorrect :
    contractRefinement config morphoCreationBytecode contract :=
  .of_runtime morphoConstructorCorrect morphoRuntimeCorrect

end Benchmarks.Morpho.MorphoBlue
