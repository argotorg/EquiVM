theorem morphoX_short {σ σ₀ A I} {g : Sat256} (v : MorphoImmutables)
    (hcode : I.code = deployedRuntime v)
    (hshort : I.calldata.size < 4) :
    RDrev (deployedRuntime v) g (initState σ σ₀ g A I) := by
  have rd0 := RD.initState (g := g) (σ := σ) (σ₀ := σ₀) (A := A) hcode
  have rd1 := morphoBlocks.morpho_block_0_fallthrough (immWords := wordsOf (immStore v)) (by simp) (by first | exact lt_four_eq_zero_of_ge hsz hsize | exact lt_four_ne_zero_of_lt hshort | exact isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort) | (rw [lt_four_eq_zero_of_ge hsz hsize]; decide) | (rw [isZero_eq_zero_of_ne (lt_four_ne_zero_of_lt hshort)]; decide)) rd0
  have rd2 := morphoBlocks.morpho_block_14 (immWords := wordsOf (immStore v)) (by simp [morphoBlocks.morpho_block_0_fallthrough_memory]) rd1
  simpa [morphoBlocks.morpho_block_0_fallthrough_memory, deployedRuntime] using rd2

